!models/artifacts/evaluation_metrics.json
!models/artifacts/*.joblib
!models/artifacts/*_metadata.json
!models/artifacts/.gitkeep

# Advanced runtime artifacts
!models/advanced_artifacts/
models/advanced_artifacts/*
